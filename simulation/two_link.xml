<mujoco model="prescribed two link arm">
  <option gravity="0 0 -9.80665" timestep="0.01"/>
  <worldbody>
    <body name="upper">
      <joint name="shoulder" type="hinge" axis="0 1 0"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.30" size="0.035" mass="1.5" contype="0" conaffinity="0"/>
      <site name="upper_sensor" pos="0 0 -0.15"/>
      <body name="forearm" pos="0 0 -0.30">
        <joint name="elbow" type="hinge" axis="0 1 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.25" size="0.025" mass="1" contype="0" conaffinity="0"/>
        <site name="lower_sensor" pos="0 0 -0.125"/>
      </body>
    </body>
  </worldbody>
  <sensor>
    <accelerometer name="upper_accel" site="upper_sensor"/>
    <accelerometer name="lower_accel" site="lower_sensor"/>
  </sensor>
</mujoco>
